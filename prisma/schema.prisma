generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Strategy {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  description String
  order       Int       @default(0)
  clusters    Cluster[]
  kpis        Kpi[]
}

model Cluster {
  id         Int      @id @default(autoincrement())
  code       String
  name       String
  strategyId Int
  strategy   Strategy @relation(fields: [strategyId], references: [id])
  order      Int      @default(0)
  kpis       Kpi[]
}

model Dimension {
  id    Int    @id @default(autoincrement())
  name  String
  order Int    @default(0)
  kpis  Kpi[]
}

model Kpi {
  id            Int            @id @default(autoincrement())
  order         Int            @default(0)
  name          String
  shortName     String?
  strategyId    Int
  strategy      Strategy       @relation(fields: [strategyId], references: [id])
  clusterId     Int?
  cluster       Cluster?       @relation(fields: [clusterId], references: [id])
  dimensionId   Int?
  dimension     Dimension?     @relation(fields: [dimensionId], references: [id])
  dataSource    String         @default("HDC")
  targetPercent Float          @default(100)
  hdcUrl        String?
  customUrl     String?
  scores        KpiScore[]
  hospScores    HospKpiScore[]
}

model KpiScore {
  id         Int      @id @default(autoincrement())
  kpiId      Int
  kpi        Kpi      @relation(fields: [kpiId], references: [id])
  fiscalYear Int
  valueA     Float    @default(0)
  valueB     Float    @default(0)
  percent    Float    @default(0)
  score      Float    @default(0)
  status     String   @default("pending")
  updatedAt  DateTime @default(now())

  @@unique([kpiId, fiscalYear])
}

model Hospital {
  id     Int            @id @default(autoincrement())
  code   String         @unique
  name   String
  type   String         @default("รพ.ชุมชน")
  scores HospKpiScore[]
}

model HospKpiScore {
  id         Int      @id @default(autoincrement())
  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  kpiId      Int
  kpi        Kpi      @relation(fields: [kpiId], references: [id])
  fiscalYear Int
  valueA     Float    @default(0)
  valueB     Float    @default(0)
  percent    Float    @default(0)
  score      Float    @default(0)
  status     String   @default("pending")
  updatedAt  DateTime @default(now())

  @@unique([hospitalId, kpiId, fiscalYear])
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  fullName  String
  role      String   @default("viewer")
  createdAt DateTime @default(now())
}
